# Server
PORT=3000

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/apexradar

# Binance Futures Thresholds
MIN_LIQUIDATION_USD=25000
MEGA_LIQUIDATION_USD=150000

# Telegram Bot (Get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx       # VIP (Private) channel ID
TELEGRAM_FREE_CHANNEL_ID=-100xxxxxxxxxx  # FREE (Public) channel ID — @ApexRadarFree
TELEGRAM_ADMIN_CHAT_ID=your_personal_chat_id
TELEGRAM_INVITE_LINK=https://t.me/+your_vip_invite_link
WHOP_PRODUCT_URL=https://whop.com/apexradar/apexradar-vip-intelligence

# Whop API & Webhooks (from whop.com/dashboard)
WHOP_API_KEY=whop_api_key_here
WHOP_WEBHOOK_SECRET=whop_webhook_secret_here
WHOP_PLAN_ID=plan_apex_vip_monthly

# Real Trading (MEXC)
MEXC_API_KEY=your_mexc_api_key
MEXC_API_SECRET=your_mexc_api_secret
